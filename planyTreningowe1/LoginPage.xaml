<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="planyTreningowe1.LoginPage"
             BackgroundColor="#1b1b1c"
             >
    <ScrollView>

        <Grid ColumnDefinitions="*" RowDefinitions="*,  8*" >
            <Border
                Background="#e3e4e6"
                Margin="40, 0, 0, 0"
                StrokeShape="RoundRectangle 0, 0, 100, 0">
                <Label
                    BackgroundColor="#e3e4e6"
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Progress"
                    FontSize="40"
                    FontAttributes="Bold"
                    TextColor="#111111"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Padding="30, 0, 0, 0">
                </Label>
            </Border>
            <Grid
                BackgroundColor="#1b1b1c"
                Grid.Column="0"
                Grid.Row="1"
                ColumnDefinitions="*"
                RowDefinitions="2*, 10*">
                <Label
                    Text="Tracker"
                    FontSize="30"
                    Padding="20, 5, 0, 0"
                    TextColor="White"
                    Grid.Row="0"
                    Grid.Column="0">

                </Label>
                <Border
                    Margin="0, 0, 20, 0"
                    Grid.Row="1"
                    Grid.Column="0"
                    BackgroundColor="#e3e4e6"
                    Padding="30"
                    StrokeShape="RoundRectangle 0, 100, 0, 0"
                    >
                    <VerticalStackLayout
                        Spacing="20">
                        <Label
                            Text="Login"
                            TextColor="Black"
                            FontAttributes="Bold"
                            FontSize="25"
                            HorizontalOptions="Center">
                        </Label>
                        <Border
                            Stroke="#CF000000" 
                            StrokeThickness="1.5" 
                            StrokeShape="RoundRectangle 8" 
                            Padding="10,0" 
                            Margin="0,10">

                            <Entry
                                x:Name="emailEntry"
                                TextColor="Black"
                                Placeholder="email"
                                PlaceholderColor="#CF000000"
                                BackgroundColor="Transparent" />
                        </Border>
                        <Border
                            Stroke="#CF000000" 
                            StrokeThickness="1.5" 
                            StrokeShape="RoundRectangle 8" 
                            Padding="10,0" 
                            Margin="0,10">

                            <Entry
                                x:Name="passwordEntry"
                                
                                TextColor="Black"
                                Placeholder="password"
                                PlaceholderColor="#CF000000"
                                BackgroundColor="Transparent" />
                        </Border>
                        <Label>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span
                                        Text="Don't have account? Click here!">
                                        <Span.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" ></TapGestureRecognizer>
                                        </Span.GestureRecognizers>
                                    </Span>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button
                            Margin="0, 30, 0, 0"
                            HorizontalOptions="Center"
                            BackgroundColor="#1b1b1c"
                            Text="LogIn"
                            FontSize="20"
                            Padding="30, 11, 30, 11"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            x:Name="loginButton"
                            Clicked="loginButton_Clicked"
                            >

                        </Button>
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Grid>
    </ScrollView>

</ContentPage>
