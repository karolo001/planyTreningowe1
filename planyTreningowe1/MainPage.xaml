<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="planyTreningowe1.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#1C1C1E"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <Border Grid.Row="0"
                BackgroundColor="#E4E5E7"
                StrokeThickness="0"
                Padding="24,35,24,28">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,0,48"/>
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*,Auto"
                  VerticalOptions="Center">

                <VerticalStackLayout Spacing="3">
                    <Label Text="Progress"
                           FontSize="34"
                           TextColor="#1C1C1E"
                           FontAttributes="Bold"/>

                    <Label Text="Tracker"
                           FontSize="19"
                           TextColor="#55565A"/>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="#1C1C1E"
                        StrokeThickness="0"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <Ellipse></Ellipse>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                    </Border.GestureRecognizers>

                    <Label Text="👤"
                           FontSize="23"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>
        <ScrollView Grid.Row="1" Margin="0, 20, 0, 0">
            <VerticalStackLayout>
                <Label Text="Your Weekly Progress"
                       TextColor="White"
                       FontSize="23"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,12"/>

                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12" Margin="20,0">
                    <Border Grid.Column="0"
                            Grid.Row="0"
                            Stroke="#E4E5E7"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="100"
                            StrokeThickness="2"
                            BackgroundColor="#E4E5E7">

                        <Grid RowDefinitions="Auto,Auto" Margin="15,10,15,10">
                            <Label Text="Training Time"
                                   Grid.Row="0"
                                   TextColor="#55565A"
                                   FontSize="20"/>
                            <Label Text="0"
                                   Grid.Row="1"
                                   x:Name="trainingTime"
                                   Margin="0,5,0,0"
                                   FontSize="25"
                                   TextColor="#55565A"
                                   FontAttributes="Bold"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1"
                            Grid.Row="0"
                            Stroke="#E4E5E7"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="100"
                            StrokeThickness="2"
                            BackgroundColor="#E4E5E7">

                        <Grid RowDefinitions="Auto,Auto" Margin="15,10,15,10">
                            <Label Text="Total Volume"
                                   Grid.Row="0"
                                   TextColor="#55565A"
                                   FontSize="20"/>
                            <Label Text="0"
                                   Grid.Row="1"
                                   x:Name="totalVolume"
                                   Margin="0,5,0,0"
                                   FontSize="25"
                                   TextColor="#55565A"
                                   FontAttributes="Bold"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="0"
                            Grid.Row="1"
                            Stroke="#E4E5E7"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="100"
                            StrokeThickness="2"
                            BackgroundColor="#E4E5E7">

                        <Grid RowDefinitions="Auto,Auto" Margin="15,10,15,10">
                            <Label Text="Workouts"
                                   Grid.Row="0"
                                   TextColor="#55565A"
                                   FontSize="20"/>
                            <Label Text="0"
                                   Grid.Row="1"
                                   x:Name="totalWorkouts"
                                   Margin="0,5,0,0"
                                   FontSize="25"
                                   TextColor="#55565A"
                                   FontAttributes="Bold"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1"
                            Grid.Row="1"
                            Stroke="#E4E5E7"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="100"
                            StrokeThickness="2"
                            BackgroundColor="#E4E5E7">

                        <Grid RowDefinitions="Auto,Auto" Margin="15,10,15,10">
                            <Label Text="Total Sets"
                                   Grid.Row="0"
                                   TextColor="#55565A"
                                   FontSize="20"/>
                            <Label Text="0"
                                   Grid.Row="1"
                                   x:Name="totalSets"
                                   Margin="0,5,0,0"
                                   FontSize="25"
                                   TextColor="#55565A"
                                   FontAttributes="Bold"/>
                        </Grid>
                    </Border>
                </Grid>

                <Label Text="Training Plan"
                       TextColor="White"
                       FontSize="23"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       Margin="0,25,0,12"/>

                <Border BackgroundColor="#2C2C2E"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Margin="20,0"
                        Padding="12">

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0"
                                    Text="&lt;"
                                    Clicked="previousWeekButton_Clicked"
                                    BackgroundColor="#3A3A3C"
                                    TextColor="White"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0"
                                    CornerRadius="18"/>

                            <Label Grid.Column="1"
                                   x:Name="weekLabel"
                                   Text="09.11 - 15.11.2026"
                                   TextColor="White"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Text="&gt;"
                                    Clicked="nextWeekButton_Clicked"
                                    BackgroundColor="#3A3A3C"
                                    TextColor="White"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0"
                                    CornerRadius="18"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6">
                            <Button Grid.Column="0"
                                    x:Name="mondayButton"
                                    ClassId="0"
                                    Text="Mon"
                                    Clicked="dayButton_Clicked"
                                    BackgroundColor="#E4E5E7"
                                    TextColor="#1C1C1E"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    HeightRequest="58"
                                    CornerRadius="12"/>
                            <Button Grid.Column="1"
                                    x:Name="tuesdayButton"
                                    ClassId="1"
                                    Text="Tue"
                                    Clicked="dayButton_Clicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#AEAEB2"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    HeightRequest="58"
                                    CornerRadius="12"/>
                            <Button Grid.Column="2"
                                    x:Name="wednesdayButton"
                                    ClassId="2"
                                    Text="Wed"
                                    Clicked="dayButton_Clicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#AEAEB2"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    HeightRequest="58"
                                    CornerRadius="12"/>
                            <Button Grid.Column="3"
                                    x:Name="thursdayButton"
                                    ClassId="3"
                                    Text="Thu"
                                    Clicked="dayButton_Clicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#AEAEB2"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    HeightRequest="58"
                                    CornerRadius="12"/>
                            <Button Grid.Column="4"
                                    x:Name="fridayButton"
                                    ClassId="4"
                                    Text="Fri"
                                    Clicked="dayButton_Clicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#AEAEB2"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    HeightRequest="58"
                                    CornerRadius="12"/>
                            <Button Grid.Column="5"
                                    x:Name="saturdayButton"
                                    ClassId="5"
                                    Text="Sat"
                                    Clicked="dayButton_Clicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#AEAEB2"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    HeightRequest="58"
                                    CornerRadius="12"/>
                            <Button Grid.Column="6"
                                    x:Name="sundayButton"
                                    ClassId="6"
                                    Text="Sun"
                                    Clicked="dayButton_Clicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#AEAEB2"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    HeightRequest="58"
                                    CornerRadius="12"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="dayLabel"
                       Text="Monday, 09.11.2026"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       Margin="20,15,20,10"/>

                <Border BackgroundColor="#E4E5E7"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Margin="20,0"
                        Padding="20">

                    <VerticalStackLayout Spacing="15">
                        <Border Stroke="#CF000000"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,0">

                            <Entry x:Name="exerciseNameEntry"
                                   TextColor="Black"
                                   Placeholder="exercise name"
                                   PlaceholderColor="#CF000000"
                                   BackgroundColor="Transparent" />
                        </Border>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    Stroke="#CF000000"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,0">

                                <Entry x:Name="setsEntry"
                                       TextColor="Black"
                                       Placeholder="sets"
                                       PlaceholderColor="#CF000000"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Border Grid.Column="1"
                                    Stroke="#CF000000"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,0">

                                <Entry x:Name="repsEntry"
                                       TextColor="Black"
                                       Placeholder="reps"
                                       PlaceholderColor="#CF000000"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Border Grid.Column="2"
                                    Stroke="#CF000000"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,0">

                                <Entry x:Name="weightEntry"
                                       TextColor="Black"
                                       Placeholder="kg"
                                       PlaceholderColor="#CF000000"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </Grid>

                        <Button HorizontalOptions="Center"
                                BackgroundColor="#1b1b1c"
                                Text="Add Exercise"
                                FontSize="20"
                                Padding="30, 11, 30, 11"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                x:Name="addExerciseButton"
                                Clicked="addExerciseButton_Clicked" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Exercises"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       Margin="20,25,20,10"/>

                <VerticalStackLayout x:Name="exercisesList"
                                     Spacing="10"
                                     Margin="20,0,20,30">

                    <BindableLayout.EmptyView>
                        <Label Text="No exercises for this day"
                               TextColor="#AEAEB2"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               Margin="0,10"/>
                    </BindableLayout.EmptyView>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#2C2C2E"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    Padding="15">

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="3">
                                        <Label Text="{Binding Name}"
                                               TextColor="White"
                                               FontSize="18"
                                               FontAttributes="Bold"/>
                                        <Label TextColor="#AEAEB2"
                                               FontSize="15">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Sets}"/>
                                                    <Span Text=" sets × "/>
                                                    <Span Text="{Binding Reps}"/>
                                                    <Span Text=" reps"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            BackgroundColor="#E4E5E7"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            Padding="12,6"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Weight, StringFormat='{0} kg'}"
                                               TextColor="#1C1C1E"
                                               FontSize="16"
                                               FontAttributes="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
